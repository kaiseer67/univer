    // train("cultured.txt", cultured_chain);  
    add_test_data();  

    cout << "Введите строку: ";
    string input;
    getline(cin, input);

    if (input.empty()) {
        cout << "Пустой ввод" << endl;
        return 0;
    }

    istringstream iss(input);
    string token;
    vector<string> results;

    while (iss >> token) {
        string current = token;
        string replacement = "";
    
        auto it = cultured_chain.find(current);
        if (it != cultured_chain.end() && !it->second.empty()) {
            replacement = choose_word(it->second);
        }
    
        //если нашли замену и она не пустая — используем её
        if (!replacement.empty()) {
            results.push_back(replacement);
        }
        //если не нашли или замена пустая — пропускаем слово
    }

    //собираем результат
    string result = "";  
    for (size_t i = 0; i < results.size(); i++) {
        if (i > 0) result += " ";  // <-- result, а не results
        result += results[i];
    }

    cout << "Результат: " << result << endl;
    return 0;
}
