unordered_map<string, unordered_map<string, int>> cultured_chain;

void train(const string& filename, unordered_map<string, unordered_map<string, int>>& chain) {
    ifstream file(filename);
    if (!file.is_open()) return;

    string prev, word;
    bool first = true;

    while (file >> word) {
        word.erase(remove_if(word.begin(), word.end(),
            [](unsigned char c) { return ispunct(c); }), word.end());
        transform(word.begin(), word.end(), word.begin(),
            [](unsigned char c) { return tolower(c); });

        if (word.empty()) continue;

        if (!first) chain[prev][word]++;
        prev = word;
        first = false;
    }
}

