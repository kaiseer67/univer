struct BSTNode {
    int value; // число в узле
    BSTNode* left; // указатель меньших
    BSTNode* right;

    BSTNode(int v) {
        value = v; //принимаемтчисло для записи в узел
        left = nullptr;
        right = nullptr;
    }
};

void insertBST(BSTNode*& root, int val) { //ссылка на указатель
    if (root == nullptr) {
        root = new BSTNode(val); //если место пустое то создаем новый узел и вставляем
        return;
    }
    if (val < root->value) {
        insertBST(root->left, val);//если число меньше, чем в узле, то идем влево
    }
    else {
        insertBST(root->right, val);
    }
}

void printBST(BSTNode* node, string prefix) {
    if (node == nullptr) {
        return;
    }
    //левый ребенок 
    printBST(node->left, prefix + "    ");

    //печатаем узел
    cout << prefix << "|--[" << node->value << "]\n";

    //потом правый ребенок
    printBST(node->right, prefix + "    ");
}

void inOrder(BSTNode* node) { //проверяем дерево
    if (node == nullptr) {
        return;
    }

    inOrder(node->left); //идем влево рекурсивно
    cout << node->value << " ";//пишем узлы начиная с конца
    inOrder(node->right);
}

struct BNode {//узел Bдерева
    vector<int> keys; // массив чисел в узле
    vector<BNode*> children;
    BNode() {
    }
};


void splitChild(BNode* parent, int idx, int M) {
    BNode* full = parent->children[idx]; // узел который делим
    BNode* sibling = new BNode(); // новый узел для правой части

    int mid = M / 2; // индекс среднего ключа

    // сохраняем средний ключ ДО обрезки вектора
    int midKey = full->keys[mid];

    // переносим ключи после среднего в новый узел
    for (int j = mid + 1; j < (int)full->keys.size(); j++) {
        sibling->keys.push_back(full->keys[j]);
    }

    // если есть дети — переносим правых детей
    if (!full->children.empty()) {
        for (int j = mid + 1; j < (int)full->children.size(); j++) {
            sibling->children.push_back(full->children[j]);
        }
        full->children.resize(mid + 1);
    }

    // обрезаем старый узел — оставляем ключи [0..mid-1]
    full->keys.resize(mid);

    // вставляем средний ключ в родителя
    parent->keys.insert(parent->keys.begin() + idx, midKey);
    parent->children.insert(parent->children.begin() + idx + 1, sibling);
}


void insertNonFull(BNode* node, int key, int M) {
    // используем int чтобы при пустом keys получить -1 а не большое число
    int i = (int)node->keys.size() - 1;

    // если лист — вставляем прямо сюда
    if (node->children.empty()) {
        node->keys.push_back(key);
        sort(node->keys.begin(), node->keys.end());
        return;
    }

    // ищем позицию для спуска (справа налево)
    while (i >= 0 && key < node->keys[i]) {
        i--;
    }
    i++; // сдвигаем на индекс ребенка

    // проверка выхода за границы
    if (i >= (int)node->children.size()) {
        i = node->children.size() - 1;
    }

    // если ребенок переполнен — делим его
    if ((int)node->children[i]->keys.size() >= M) {
        splitChild(node, i, M);
        // после split ключ node->keys[i] это поднявшийся из child
        if (key > node->keys[i]) {
            i++;
        }
    }

    // рекурсивный спуск с проверкой границ
    if (i >= 0 and i < (int)node->children.size()) {
        insertNonFull(node->children[i], key, M);
    }
}

// главная вставка в B-дерево
void insertBTree(BNode*& root, int key, int M) {
    if (root == nullptr) {
        root = new BNode();
        root->keys.push_back(key);
        return;
    }

    // если корень переполнен — создаём новый корень
    if ((int)root->keys.size() >= M) {
        BNode* newRoot = new BNode();
        newRoot->children.push_back(root);
        splitChild(newRoot, 0, M);
        root = newRoot;

        // выбираем ребёнка для вставки
        int i = 0;
        if (!root->keys.empty() and key > root->keys[0]) {
            i = 1;
        }
        if (i < (int)root->children.size()) {
            insertNonFull(root->children[i], key, M);
        }
    }
    else {
        insertNonFull(root, key, M);
    }
}

// печать узла B-дерева
void printBNode(BNode* node, string prefix) { // принимаем узел и отступ
    if (node == nullptr) {
        return;
    } // если узел пустой — выходим

    cout << prefix << "|--["; // печатаем отступ, ветку и открывающую скобку
    for (size_t i = 0; i < node->keys.size(); i++) { // перебираем все ключи в узле
        cout << node->keys[i]; // печатаем значение ключа
        if (i != node->keys.size() - 1) { // если это не последний ключ
            cout << " | "; // печатаем разделитель
        }
    }
    cout << "]\n"; // закрываем скобку и переходим на новую строку

    string newPrefix = prefix + "    "; // обновляем отступ для детей
    for (size_t i = 0; i < node->children.size(); i++) { // перебираем всех детей
        if (node->children[i] != nullptr) {
            printBNode(node->children[i], newPrefix); // рекурсивно печатаем ребёнка
        }
    }
}

// печать всего B-дерева
void printBTree(BNode* root) {
    printBNode(root, "");
}


int readInt(string prompt, int minV, int maxV) {
    int val; // переменная для значения
    while (true) { // повторяем пока не введут правильно
        cout << prompt;
        cin >> val;
        if (cin.fail() or val < minV or val > maxV) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Ошибка. Введите число от " << minV << " до " << maxV << ".\n";
        }
        else {
            cin.ignore(10000, '\n');
            return val;
        }
    }
}

vector<int> getData(int& N) {
    N = readInt("Введите количество элементов N (1-1000): ", 1, 1000);
    int mode = readInt("1. Ручной ввод\n2. Автогенерация (1..N)\nВаш выбор: ", 1, 2);

    vector<int> data(N); // создаём вектор нужного размера
    if (mode == 1) {
        cout << "Введите " << N << " чисел через пробел: ";
        for (int i = 0; i < N; ++i) cin >> data[i];
        cin.ignore(10000, '\n');
    }
    else {
        for (int i = 0; i < N; i++) {
            data[i] = rand() % N + 1; // число от 1 до N
        }
    }
    return data;
}


void runBST() {
    int N; // количество элементов
    vector<int> nums = getData(N);
    BSTNode* root = nullptr; // пустой корень
    for (int i = 0; i < nums.size(); i++) {
        insertBST(root, nums[i]); // вставляем все числа
    }

    cout << "\n--- BST (правая ветка сверху) ---\n";
    printBST(root, "");
    cout << "\nПроверка: ";
    inOrder(root);
    cout << "\n\n";
}


void runBTree() {
    int M = readInt("Введите порядок дерева M (3-5): ", 3, 5);
    int N;
    vector<int> nums = getData(N);

    BNode* root = nullptr; // пустой корень B-дерева
    cout << "\n--- Построение B-дерева (M=" << M << ") ---\n";

    // сначала строим дерево полностью
    for (int i = 0; i < nums.size(); i++) {
        insertBTree(root, nums[i], M);
    }

    // потом выводим готовое дерево
    printBTree(root);
    cout << "\n";
}

